-- Gemini did this im lazy

return {
    'mfussenegger/nvim-jdtls',
    ft = 'java',
    config = function()
        local jdtls = require('jdtls')
        local jdtls_path = '/opt/eclipse.jdt.ls-1.52.0/org.eclipse.jdt.ls.product/scripts/jdtls' -- The path to the jdtls launcher script
        local workspace_dir = vim.fn.stdpath('data') .. '/jdtls-workspace/' .. vim.fn.fnamemodify(detected_root_dir, ':p:h:t')

        local detected_root_dir = require('jdtls.setup').find_root({'.git', 'mvnw', 'gradlew', 'pom.xml', 'build.gradle'})
        local workspace_dir = vim.fn.stdpath('data') .. '/jdtls-workspace/' .. vim.fn.fnamemodify(detected_root_dir, ':p:h:t')
        local config_dir = vim.fn.stdpath('cache') .. '/jdtls-config'

        local config = {
            cmd = {
                jdtls_path,
                '-configuration',
                config_dir,
                '-data',
                workspace_dir,
            },

            -- Set the root directory to where the project is.
            root_dir = detected_root_dir,

            settings = {
                java = {}
            },
        }

        jdtls.start_or_attach(config)
    end,
}
